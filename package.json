{
  "name": "nist-sp800-63-4-glossary-map",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build:data": "node --import tsx scripts/build-data.ts",
    "build": "npm run build:data && tsc --noEmit && vite build && vite build --config vite.widget.config.ts && node --import tsx scripts/package-widget.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:upstream": "node --import tsx scripts/update.ts",
    "freeze:widget": "node --import tsx scripts/package-widget.ts --freeze"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "parse5": "^8.0.1"
  }
}
